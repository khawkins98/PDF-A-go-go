{
  "name": "pdf-a-go-go",
  "version": "1.6.0",
  "description": "A lightweight, accessible, embeddable PDF viewer that uses pdf.js.",
  "keywords": [
    "pdf",
    "viewer",
    "accessible",
    "javascript",
    "web",
    "pdf.js",
    "opensource"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/khawkins98/PDF-A-go-go.git"
  },
  "author": "Ken Hawkins",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/khawkins98/PDF-A-go-go/issues"
  },
  "homepage": "https://github.com/khawkins98/PDF-A-go-go#readme",
  "private": true,
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test:serve": "serve dist -l 9000",
    "pretest": "yarn build",
    "test": "start-server-and-test test:serve http://localhost:9000 'playwright test'",
    "test:debug": "start-server-and-test test:serve http://localhost:9000 'playwright test --debug'",
    "size": "node scripts/check-bundle-size.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "copy-webpack-plugin": "^14.0.0",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.0",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "pdfjs-dist": "^5.7.284"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
