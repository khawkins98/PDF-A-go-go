#!/bin/sh
#
# commit-msg hook: reject AI/agent co-author trailers and generated-by lines.
#
# PDF-A-go-go keeps its history free of AI/agent attribution noise. This hook
# blocks commit messages that contain machine-generated co-author trailers or
# "generated with" style lines. Matching is case-insensitive.
#
# Installed automatically via `yarn install` (the "prepare" script runs
# `git config core.hooksPath .githooks`). Contributors can also wire it up
# manually with:  git config core.hooksPath .githooks

msg_file="$1"
[ -z "$msg_file" ] && exit 0
[ -f "$msg_file" ] || exit 0

# Strip comment lines (git's own template comments) before scanning.
scan="$(grep -v '^#' "$msg_file" 2>/dev/null)"

fail() {
  echo "-----------------------------------------------------------------" >&2
  echo "commit-msg hook: disallowed AI/agent attribution in commit message" >&2
  echo "" >&2
  echo "  Offending line: $1" >&2
  echo "" >&2
  echo "  This repo does not accept AI/agent co-author trailers or" >&2
  echo "  machine-generated attribution lines. Please remove it and" >&2
  echo "  commit again." >&2
  echo "-----------------------------------------------------------------" >&2
  exit 1
}

# Co-authored-by lines naming an AI agent/tool/vendor.
offending="$(printf '%s\n' "$scan" | grep -iE \
  'co-authored-by:.*(claude|anthropic|openai|chatgpt|gpt|codex|copilot|cursor|\bai\b|\bbot\b)' \
  | head -n 1)"
[ -n "$offending" ] && fail "$offending"

# "Generated with" / "Generated by" style lines, including the robot emoji.
offending="$(printf '%s\n' "$scan" | grep -iE \
  '(generated (with|by)|🤖[[:space:]]*generated)' \
  | head -n 1)"
[ -n "$offending" ] && fail "$offending"

exit 0
